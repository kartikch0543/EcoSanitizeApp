@model IEnumerable<EcoSanitizeApp.Models.SanitizationAudit>
@{
    ViewData["Title"] = "Sanitization Audits";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 fw-bold mb-1">Sanitization Management and Audits</h1>
        <p class="text-secondary small mb-0">Total inspections: <strong>@ViewData["TotalAudits"]</strong> | Areas requiring follow-up: <strong class="text-danger">@ViewData["FollowUpCount"]</strong></p>
    </div>
    <a asp-action="Create" class="btn-app-primary">
        + Record New Audit
    </a>
</div>

<div class="table-responsive table-portal">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th style="width: 8%;">ID</th>
                <th style="width: 25%;">Facility / Area Name</th>
                <th style="width: 15%;">Cleanliness Score</th>
                <th style="width: 18%;">Disinfectant Applied</th>
                <th style="width: 12%;">Inspector</th>
                <th style="width: 11%;">Follow-up Needed</th>
                <th style="width: 11%; text-align: center;">Outcome</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var audit in Model)
            {
                <tr>
                    <td class="fw-bold text-muted">#@audit.Id</td>
                    <td class="fw-semibold">@audit.AreaName</td>
                    <td>
                        <span class="cleanliness-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= audit.CleanlinessScore)
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span class="text-muted opacity-25">☆</span>
                                }
                            }
                        </span>
                        <span class="small fw-semibold text-muted ms-1">(@audit.CleanlinessScore/5)</span>
                    </td>
                    <td><code class="text-dark bg-light px-2 py-1 rounded border">@audit.DisinfectantUsed</code></td>
                    <td class="small text-secondary">@audit.InspectorName</td>
                    <td>
                        @if (audit.RequiresFollowUp)
                        {
                            <span class="badge-followup badge-followup-action">Action Required</span>
                        }
                        else
                        {
                            <span class="badge-followup badge-followup-compliant">Compliant</span>
                        }
                    </td>
                    <td style="text-align: center;">
                        @if (audit.ResultStatus == "Pass")
                        {
                            <span class="badge-status badge-outcome-pass">Pass</span>
                        }
                        else
                        {
                            <span class="badge-status badge-outcome-attention">Needs Attention</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
