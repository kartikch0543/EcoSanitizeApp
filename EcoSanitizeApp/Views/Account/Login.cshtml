@model EcoSanitizeApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-4">
    <div class="col-md-5">
        <div class="panel-civic shadow-sm">
            <div class="panel-civic-header text-center py-3 bg-light">
                <div class="fw-bold fs-5 text-dark">Portal Authentication</div>
                <div class="text-secondary small">Sign in to access municipal operations</div>
            </div>
            <div class="panel-civic-body p-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" placeholder="Enter username (e.g. officer)" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn-civic-primary py-2">Sign In</button>
                    </div>

                    <div class="text-center small text-secondary">
                        Do not have an account?
                        <a asp-action="Register" class="text-decoration-none fw-semibold">Register / Sign Up</a>
                    </div>
                </form>

                <div class="mt-4 pt-3 border-top small text-secondary">
                    <div class="fw-semibold mb-1 text-dark">Demo User Credentials:</div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Sanitation Officer:</span>
                        <code>officer / officer123</code>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Administrator:</span>
                        <code>admin / admin123</code>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Facility Manager:</span>
                        <code>citizen / citizen123</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
