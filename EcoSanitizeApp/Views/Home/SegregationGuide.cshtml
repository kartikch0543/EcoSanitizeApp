@{
    ViewData["Title"] = "Waste Segregation Guidelines";
}

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">Waste Segregation Guidelines</h1>
    <p class="text-secondary small">Standard municipal classifications for source segregation, storage containers, and processing facilities.</p>
</div>

<div class="row g-3">
    <!-- Organic -->
    <div class="col-md-6">
        <div class="panel-civic h-100">
            <div class="panel-civic-header d-flex justify-content-between align-items-center">
                <span>Green Stream: Organic Waste</span>
                <span class="badge bg-success">Hazard 1</span>
            </div>
            <div class="panel-civic-body">
                <p class="small text-secondary mb-2"><strong>Accepted Materials:</strong> Food scraps, fruit and vegetable peels, tea grounds, leaves, garden clippings, and compostable organic matter.</p>
                <p class="small text-secondary mb-2"><strong>Handling Procedure:</strong> Keep collection bins covered to prevent pest entry and moisture accumulation. Do not mix with non-biodegradable plastics.</p>
                <p class="small text-secondary mb-0"><strong>Target Facility:</strong> Municipal Composting Facility or Anaerobic Biogas Digester.</p>
            </div>
        </div>
    </div>

    <!-- Recyclable -->
    <div class="col-md-6">
        <div class="panel-civic h-100">
            <div class="panel-civic-header d-flex justify-content-between align-items-center">
                <span>Blue Stream: Recyclable Dry Waste</span>
                <span class="badge bg-primary">Hazard 2</span>
            </div>
            <div class="panel-civic-body">
                <p class="small text-secondary mb-2"><strong>Accepted Materials:</strong> PET plastic bottles, clean containers, corrugated cardboard boxes, newspapers, glass bottles, aluminum and tin cans.</p>
                <p class="small text-secondary mb-2"><strong>Handling Procedure:</strong> Rinse residual liquids, flatten boxes and containers to conserve space, and ensure materials remain dry.</p>
                <p class="small text-secondary mb-0"><strong>Target Facility:</strong> Material Recovery Facility (MRF) for mechanical sorting and baling.</p>
            </div>
        </div>
    </div>

    <!-- Hazardous -->
    <div class="col-md-6">
        <div class="panel-civic h-100">
            <div class="panel-civic-header d-flex justify-content-between align-items-center">
                <span>Red Stream: Hazardous and Chemical Waste</span>
                <span class="badge bg-danger">Hazard 8</span>
            </div>
            <div class="panel-civic-body">
                <p class="small text-secondary mb-2"><strong>Accepted Materials:</strong> Household and industrial batteries, paint cans, solvents, laboratory chemical residues, fluorescent light tubes.</p>
                <p class="small text-secondary mb-2"><strong>Handling Procedure:</strong> Seal in leak-proof chemical containers. Wear protective gloves and eye gear during pickup. Never mix with general municipal waste.</p>
                <p class="small text-secondary mb-0"><strong>Target Facility:</strong> Specialized Hazardous Waste Containment and Chemical Neutralization Plant.</p>
            </div>
        </div>
    </div>

    <!-- Sanitary -->
    <div class="col-md-6">
        <div class="panel-civic h-100">
            <div class="panel-civic-header d-flex justify-content-between align-items-center">
                <span>Yellow Stream: Sanitary and Biomedical Waste</span>
                <span class="badge bg-warning text-dark">Hazard 7</span>
            </div>
            <div class="panel-civic-body">
                <p class="small text-secondary mb-2"><strong>Accepted Materials:</strong> Used bandages, medical dressings, disposable diapers, sanitary napkins, examination gloves, discarded face masks.</p>
                <p class="small text-secondary mb-2"><strong>Handling Procedure:</strong> Double-bag in durable yellow biohazard bags. Fasten tightly with secure closures. Direct transfer to incineration transit vehicles.</p>
                <p class="small text-secondary mb-0"><strong>Target Facility:</strong> High-Temperature Medical Waste Incinerator.</p>
            </div>
        </div>
    </div>

    <!-- E-Waste -->
    <div class="col-md-12">
        <div class="panel-civic h-100">
            <div class="panel-civic-header d-flex justify-content-between align-items-center">
                <span>Orange Stream: Electronic Waste (E-Waste)</span>
                <span class="badge" style="background-color: #ea580c; color: #fff;">Hazard 5</span>
            </div>
            <div class="panel-civic-body">
                <p class="small text-secondary mb-2"><strong>Accepted Materials:</strong> Old computers, mobile phones, chargers, circuit boards, printer cartridges, televisions, small home appliances, lithium batteries.</p>
                <p class="small text-secondary mb-2"><strong>Handling Procedure:</strong> Do not break glass panels or puncture internal batteries. Store in dry, weatherproof containers away from direct heat.</p>
                <p class="small text-secondary mb-0"><strong>Target Facility:</strong> Authorized Electronic Waste Dismantling, Hazardous Metal Recovery, and Precious Metal Extraction Facility.</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 pt-3 border-top">
    <a class="btn-civic-primary" asp-controller="Disposal" asp-action="Create">+ Log Collection Request for These Streams</a>
</div>
