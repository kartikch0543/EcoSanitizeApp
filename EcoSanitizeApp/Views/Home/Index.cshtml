@model EcoSanitizeApp.Models.DashboardSummary
@{
    ViewData["Title"] = "Operations Dashboard";
}

<!-- Hero Section (Restrained Civic Palette) -->
<div class="hero-civic-card">
    <div class="row align-items-center">
        <div class="col-lg-8 mb-4 mb-lg-0">
            <div class="hero-dept-tag">
                Municipal Operations &bull; Sanitation Division
            </div>
            <h1 class="hero-civic-title">
                EcoSanitize Portal
            </h1>
            <p class="hero-civic-subtitle">
                Urban waste segregation management, disposal logistics dispatch, and facility sanitization inspections.
            </p>
            <div class="d-flex flex-wrap gap-2 pt-1">
                <a class="btn-civic-accent" asp-controller="Disposal" asp-action="Create">
                    + Log Waste Disposal Request
                </a>
                <a class="btn-civic-outline" asp-controller="Sanitization" asp-action="Create">
                    Record Sanitization Audit
                </a>
                <a class="btn-civic-outline" asp-controller="Home" asp-action="SegregationGuide">
                    Segregation Rules
                </a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="hero-civic-stat">
                <div class="stat-label-small">Total Waste Managed</div>
                <div class="stat-value-large">
                    @Model.TotalWeightKg <span class="stat-unit-text">kg</span>
                </div>
                <div class="progress mb-2" style="height: 6px;">
                    <div class="progress-bar bg-success" style="width: 75%"></div>
                </div>
                <div class="small text-muted">
                    Active municipal collection queue
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3 Metric Cards (Rectangular, Civic Style) -->
<div class="row g-3 mb-4">
    <!-- Card 1 -->
    <div class="col-md-4">
        <div class="metric-card-civic">
            <div>
                <span class="metric-title-small">Total Disposal Requests</span>
                <div class="metric-digit-large text-primary">
                    @Model.TotalRequests
                </div>
            </div>
            <a asp-controller="Disposal" asp-action="Index" class="btn-metric-route text-primary">
                View All Requests &rarr;
            </a>
        </div>
    </div>

    <!-- Card 2 -->
    <div class="col-md-4">
        <div class="metric-card-civic">
            <div>
                <span class="metric-title-small">Pending Collection</span>
                <div class="metric-digit-large text-warning">
                    @Model.PendingRequests
                </div>
            </div>
            <a href="/Disposal" class="btn-metric-route text-warning">
                Review Pending Queue &rarr;
            </a>
        </div>
    </div>

    <!-- Card 3 -->
    <div class="col-md-4">
        <div class="metric-card-civic">
            <div>
                <span class="metric-title-small">Emergency / High Priority</span>
                <div class="metric-digit-large text-danger">
                    @Model.HighPriorityRequests
                </div>
            </div>
            <a href="/Disposal?priority=High" class="btn-metric-route text-danger">
                Urgent Queue &rarr;
            </a>
        </div>
    </div>
</div>

<!-- 3 Solution Pillars -->
<div class="mb-3">
    <h2 class="h5 fw-bold mb-1">Operational Modules</h2>
    <p class="text-secondary small mb-0">Core workflows for waste segregation compliance, logistics dispatch, and facility hygiene.</p>
</div>

<div class="row g-3">
    <!-- Module 1: Waste Segregation -->
    <div class="col-md-4">
        <div class="panel-civic h-100">
            <div class="panel-civic-header d-flex justify-content-between align-items-center">
                <span>1. Waste Segregation</span>
                <span class="badge bg-secondary">Streams</span>
            </div>
            <div class="panel-civic-body">
                <p class="small text-secondary mb-3">
                    Classifies municipal waste into 4 designated streams: Organic (Green Wet), Recyclable (Blue Dry), Hazardous (Red Toxic), and Sanitary (Yellow Biohazard).
                </p>
                <div class="small text-secondary mb-3">
                    <span class="me-2"><span class="stream-dot dot-organic"></span>Organic</span>
                    <span class="me-2"><span class="stream-dot dot-recyclable"></span>Recyclable</span>
                    <span class="me-2"><span class="stream-dot dot-hazardous"></span>Hazardous</span>
                    <span><span class="stream-dot dot-sanitary"></span>Sanitary</span>
                </div>
                <a class="btn-civic-secondary w-100" asp-controller="Home" asp-action="SegregationGuide">
                    Review Segregation Rules &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Module 2: Disposal Tracking -->
    <div class="col-md-4">
        <div class="panel-civic h-100">
            <div class="panel-civic-header d-flex justify-content-between align-items-center">
                <span>2. Disposal Tracking</span>
                <span class="badge bg-secondary">Logistics</span>
            </div>
            <div class="panel-civic-body">
                <p class="small text-secondary mb-3">
                    Monitors pickup requests from submission to final destination. Coordinates driver assignments, urgency triage, and collection status updates.
                </p>
                <div class="d-flex align-items-center gap-2 mb-3 small">
                    <span class="badge-status-pending">Pending</span>
                    <span>&rarr;</span>
                    <span class="badge-status-transit">In-Transit</span>
                    <span>&rarr;</span>
                    <span class="badge-status-disposed">Disposed</span>
                </div>
                <a class="btn-civic-secondary w-100" asp-controller="Disposal" asp-action="Index">
                    Open Disposal Queue &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Module 3: Sanitization Audits -->
    <div class="col-md-4">
        <div class="panel-civic h-100">
            <div class="panel-civic-header d-flex justify-content-between align-items-center">
                <span>3. Sanitization Audits</span>
                <span class="badge bg-secondary">Compliance</span>
            </div>
            <div class="panel-civic-body">
                <p class="small text-secondary mb-3">
                    Audits cleanliness of public facilities, restrooms, and transit stations. Records chemical disinfectants and automatically triggers follow-up cleaning orders.
                </p>
                <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded border">
                    <span class="small text-muted">Audits Logged: <strong>@Model.TotalAudits</strong></span>
                    <span class="small text-danger">Action Required: <strong>@Model.FollowUpAuditsCount</strong></span>
                </div>
                <a class="btn-civic-secondary w-100" asp-controller="Sanitization" asp-action="Index">
                    Open Sanitization Logs &rarr;
                </a>
            </div>
        </div>
    </div>
</div>
