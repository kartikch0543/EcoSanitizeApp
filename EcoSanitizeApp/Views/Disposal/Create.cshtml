@model EcoSanitizeApp.Models.DisposalRequest
@{
    ViewData["Title"] = "Log Disposal Request";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-3">
            <h1 class="h4 fw-bold mb-1">Log Disposal Request</h1>
            <p class="text-secondary small">Enter location details and waste classification for municipal collection dispatch.</p>
        </div>

        <div class="panel-civic">
            <div class="panel-civic-header">Request Details</div>
            <div class="panel-civic-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="Ward number, facility, or street address" autofocus />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="">Select Stream</option>
                                <option value="Organic">Organic (Green Stream - Wet Waste)</option>
                                <option value="Recyclable">Recyclable (Blue Stream - Dry Waste)</option>
                                <option value="Hazardous">Hazardous (Red Stream - Toxic/Chemical)</option>
                                <option value="Sanitary">Sanitary (Yellow Stream - Biohazard)</option>
                                <option value="E-Waste">E-Waste (Orange Stream - Electronic Waste)</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="EstimatedWeightKg" class="form-label"></label>
                            <input asp-for="EstimatedWeightKg" type="number" step="0.1" class="form-control" placeholder="e.g. 45.0" />
                            <span asp-validation-for="EstimatedWeightKg" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low (Scheduled route)</option>
                                <option value="Medium" selected>Medium (Standard 24-hr)</option>
                                <option value="High">High (Urgent within 6 hrs)</option>
                                <option value="Emergency">Emergency (Immediate dispatch)</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="AssignedCollector" class="form-label"></label>
                            <input asp-for="AssignedCollector" class="form-control" placeholder="Optional designated vehicle unit" />
                            <span asp-validation-for="AssignedCollector" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SpecialNotes" class="form-label"></label>
                        <textarea asp-for="SpecialNotes" rows="3" class="form-control" placeholder="Specific access instructions, chemical identifiers, or container locations"></textarea>
                        <span asp-validation-for="SpecialNotes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn-civic-secondary">Cancel and Return</a>
                        <button type="submit" class="btn-civic-primary">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
