@using Microsoft.AspNetCore.Http
@{
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    bool isDashboardActive = currentCtrl == "Home" && currentAct == "Index";
    bool isOperationsActive = currentCtrl == "Disposal" || currentCtrl == "Complaint" || currentCtrl == "Sanitization";
    bool isLogisticsActive = currentCtrl == "Worker" || currentCtrl == "Schedule" || (currentCtrl == "Home" && currentAct == "SegregationGuide");
    bool isReportsActive = currentCtrl == "Analytics";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoSanitize Municipal Portal</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="civic-portal-body">
    <!-- Modern Enterprise Horizontal Top Navbar -->
    <header class="civic-navbar sticky-top">
        <nav class="navbar navbar-expand-xl navbar-light bg-white p-0">
            <div class="container-fluid px-3 px-lg-4">
                <!-- Brand: Logo & Title -->
                <a class="navbar-brand d-flex align-items-center gap-2 py-2 me-4" asp-controller="Home" asp-action="Index">
                    <div class="brand-emblem-top">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                        </svg>
                    </div>
                    <div class="brand-text-block">
                        <span class="brand-title">EcoSanitize</span>
                        <span class="brand-badge-pill">Municipal Operations</span>
                    </div>
                </a>

                <!-- Responsive Hamburger Toggler for Mobile / Tablet -->
                <button class="navbar-toggler border-0 shadow-none px-2" type="button" data-bs-toggle="collapse" data-bs-target="#civicNavbarCollapse" aria-controls="civicNavbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links & Right Utilities -->
                <div class="collapse navbar-collapse" id="civicNavbarCollapse">
                    <!-- Central Nav Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0 align-items-xl-center gap-1">
                        <!-- 1. Dashboard -->
                        <li class="nav-item">
                            <a class="nav-link-topbar @(isDashboardActive ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <svg class="nav-icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                                <span>Dashboard</span>
                            </a>
                        </li>

                        <!-- 2. Operations Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link-topbar dropdown-toggle @(isOperationsActive ? "active" : "")" href="#" id="operationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg class="nav-icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                <span>Operations</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-civic shadow-sm border-0" aria-labelledby="operationsDropdown">
                                <li>
                                    <a class="dropdown-item dropdown-item-civic @(currentCtrl == "Disposal" ? "active" : "")" asp-controller="Disposal" asp-action="Index">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                        <span>Disposal Tracking</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-civic @(currentCtrl == "Complaint" ? "active" : "")" asp-controller="Complaint" asp-action="Index">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                        <span>Grievance Complaints</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-civic @(currentCtrl == "Sanitization" ? "active" : "")" asp-controller="Sanitization" asp-action="Index">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                                        <span>Sanitization Audits</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 3. Logistics Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link-topbar dropdown-toggle @(isLogisticsActive ? "active" : "")" href="#" id="logisticsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg class="nav-icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                <span>Logistics &amp; Field</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-civic shadow-sm border-0" aria-labelledby="logisticsDropdown">
                                <li>
                                    <a class="dropdown-item dropdown-item-civic @(currentCtrl == "Worker" ? "active" : "")" asp-controller="Worker" asp-action="Index">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                        <span>Sanitation Workers</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-civic @(currentCtrl == "Schedule" ? "active" : "")" asp-controller="Schedule" asp-action="Index">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        <span>Collection Schedules</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-civic @(currentCtrl == "Home" && currentAct == "SegregationGuide" ? "active" : "")" asp-controller="Home" asp-action="SegregationGuide">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                        <span>Segregation Rules</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 4. Reports Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link-topbar dropdown-toggle @(isReportsActive ? "active" : "")" href="#" id="reportsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg class="nav-icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                                <span>Reports &amp; Intelligence</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-civic shadow-sm border-0" aria-labelledby="reportsDropdown">
                                <li>
                                    <a class="dropdown-item dropdown-item-civic @(currentCtrl == "Analytics" && currentAct == "Index" ? "active" : "")" asp-controller="Analytics" asp-action="Index">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                                        <span>Analytics &amp; Export</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-civic" asp-controller="Analytics" asp-action="PrintableReport" target="_blank">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                        <span>Printable Audit Report</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Right Utilities -->
                    <div class="d-flex flex-wrap align-items-center gap-2 pt-2 pt-xl-0">
                        <!-- Live System Status -->
                        <div class="gateway-status-pill d-none d-xxl-inline-flex align-items-center me-1">
                            <span class="status-indicator-dot me-2"></span>
                            <span>Gateway: Online</span>
                        </div>

                        <!-- + Quick Action Dropdown -->
                        <div class="dropdown">
                            <button class="btn-topbar-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                + Quick Action
                            </button>
                            <ul class="dropdown-menu dropdown-menu-civic dropdown-menu-end shadow-sm border-0">
                                <li><a class="dropdown-item dropdown-item-civic py-2" asp-controller="Disposal" asp-action="Create">+ Log Disposal Request</a></li>
                                <li><a class="dropdown-item dropdown-item-civic py-2" asp-controller="Complaint" asp-action="Create">+ File Citizen Grievance</a></li>
                                <li><a class="dropdown-item dropdown-item-civic py-2" asp-controller="Sanitization" asp-action="Create">+ Record Sanitization Audit</a></li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li><a class="dropdown-item dropdown-item-civic py-2" asp-controller="Worker" asp-action="Create">+ Register Field Worker</a></li>
                                <li><a class="dropdown-item dropdown-item-civic py-2" asp-controller="Schedule" asp-action="Create">+ Add Route Timetable</a></li>
                            </ul>
                        </div>

                        <!-- User Profile Authentication Block -->
                        @{
                            var username = Context.Session.GetString("Username");
                            var fullName = Context.Session.GetString("FullName") ?? username;
                            var role = Context.Session.GetString("UserRole") ?? "Citizen / User";
                        }
                        @if (!string.IsNullOrEmpty(username))
                        {
                            <div class="user-pill-topbar d-flex align-items-center">
                                <div class="user-avatar-topbar">
                                    @(!string.IsNullOrEmpty(fullName) ? fullName[0].ToString().ToUpper() : "U")
                                </div>
                                <div class="user-meta-topbar d-none d-sm-block">
                                    <div class="user-name-text">@fullName</div>
                                    <div class="user-role-text">@role</div>
                                </div>
                                <a class="btn-logout-topbar ms-2" asp-controller="Account" asp-action="Logout" title="Sign Out">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                </a>
                            </div>
                        }
                        else
                        {
                            <a class="btn-civic-primary py-1 px-3" asp-controller="Account" asp-action="Login">
                                Sign In / Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Viewport Area (Full Available Width) -->
    <main class="civic-main-viewport container-fluid px-3 px-lg-5 py-4" role="main">
        <!-- Toast Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="civic-toast civic-toast-success alert alert-dismissible fade show mb-3" role="alert">
                <div class="d-flex align-items-center">
                    <svg class="me-2 text-success flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <div>
                        <strong>Success:</strong> @TempData["SuccessMessage"]
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="civic-toast civic-toast-danger alert alert-dismissible fade show mb-3" role="alert">
                <div class="d-flex align-items-center">
                    <svg class="me-2 text-danger flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <div>
                        <strong>Notice:</strong> @TempData["ErrorMessage"]
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Clean Municipal Footer -->
    <footer class="civic-portal-footer mt-auto py-3">
        <div class="container-fluid px-3 px-lg-5 d-flex flex-wrap justify-content-between align-items-center">
            <div class="footer-meta">
                &copy; 2026 EcoSanitize Municipal Waste Management &amp; Sanitization Portal. All rights reserved.
            </div>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <a asp-controller="Home" asp-action="Terms">Terms and Conditions</a>
                <a asp-controller="Analytics" asp-action="PrintableReport" target="_blank">Printable Audit Report</a>
            </div>
        </div>
    </footer>

    <!-- Generic Confirmation Modal -->
    <div class="modal fade" id="civicConfirmModal" tabindex="-1" aria-labelledby="civicConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="civicConfirmModalLabel">Confirm Municipal Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="civicConfirmModalBody">
                    Are you sure you want to proceed with this update?
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" id="civicConfirmModalBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
