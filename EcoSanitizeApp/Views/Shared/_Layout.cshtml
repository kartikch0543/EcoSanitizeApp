@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoSanitize Platform</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar-custom">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <a class="navbar-brand-custom d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="fs-4 me-2">🌿</span>
                    <span class="fw-bold text-white">Eco<span class="text-success">Sanitize</span></span>
                </a>

                <nav class="d-flex align-items-center gap-1 my-2 my-lg-0">
                    <a class="nav-link-item" asp-controller="Home" asp-action="Index">Dashboard</a>
                    <a class="nav-link-item" asp-controller="Home" asp-action="SegregationGuide">Segregation Rules</a>
                    <a class="nav-link-item" asp-controller="Disposal" asp-action="Index">Disposal Tracking</a>
                    <a class="nav-link-item" asp-controller="Sanitization" asp-action="Index">Sanitization System</a>
                </nav>

                <div class="d-flex align-items-center gap-2">
                    @{
                        var username = Context.Session.GetString("Username");
                        var fullName = Context.Session.GetString("FullName") ?? username;
                        var role = Context.Session.GetString("UserRole") ?? "User";
                    }
                    @if (!string.IsNullOrEmpty(username))
                    {
                        <span class="badge bg-dark border text-light px-3 py-2">
                            👤 @fullName (@role)
                        </span>
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-success btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Login">
                            Sign In / Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <div class="container my-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-1 mb-3" role="alert">
                <strong>Success:</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-1 mb-3" role="alert">
                <strong>Notice:</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="portal-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div>
                &copy; 2026 EcoSanitize Municipal Operations Portal. All rights reserved.
            </div>
            <div>
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <a asp-controller="Home" asp-action="Terms">Terms and Conditions</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
