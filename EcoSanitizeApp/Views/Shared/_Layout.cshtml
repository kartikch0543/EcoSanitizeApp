@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoSanitize Municipal Portal</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="civic-portal-body">
    <div class="app-layout-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-header">
                <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                    <div class="brand-emblem">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                        </svg>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">EcoSanitize</span>
                        <span class="brand-subtitle">Municipal Operations</span>
                    </div>
                </a>
                <button type="button" class="sidebar-close-btn d-lg-none" id="sidebarCloseBtn" aria-label="Close Sidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <div class="sidebar-menu-wrapper">
                <div class="sidebar-section-title">Core Operations</div>
                <nav class="sidebar-nav">
                    <a class="nav-item-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        <span>Dashboard</span>
                    </a>

                    <a class="nav-item-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Disposal" ? "active" : "")" asp-controller="Disposal" asp-action="Index">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        <span>Disposal Tracking</span>
                    </a>

                    <a class="nav-item-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Complaint" ? "active" : "")" asp-controller="Complaint" asp-action="Index">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span>Grievance Complaints</span>
                    </a>

                    <a class="nav-item-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Sanitization" ? "active" : "")" asp-controller="Sanitization" asp-action="Index">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                        <span>Sanitization Audits</span>
                    </a>

                    <div class="sidebar-section-title">Logistics &amp; Field</div>

                    <a class="nav-item-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Worker" ? "active" : "")" asp-controller="Worker" asp-action="Index">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>Sanitation Workers</span>
                    </a>

                    <a class="nav-item-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Schedule" ? "active" : "")" asp-controller="Schedule" asp-action="Index">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <span>Collection Schedules</span>
                    </a>

                    <a class="nav-item-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "SegregationGuide" ? "active" : "")" asp-controller="Home" asp-action="SegregationGuide">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        <span>Segregation Rules</span>
                    </a>

                    <div class="sidebar-section-title">Intelligence &amp; Reports</div>

                    <a class="nav-item-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Analytics" ? "active" : "")" asp-controller="Analytics" asp-action="Index">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                        <span>Analytics &amp; Export</span>
                    </a>
                </nav>
            </div>

            <div class="sidebar-footer">
                <div class="sidebar-system-status">
                    <span class="status-indicator-dot"></span>
                    <span>Kestrel Municipal Gateway: Online</span>
                </div>
            </div>
        </aside>

        <!-- Sidebar Overlay for Mobile -->
        <div class="sidebar-overlay d-lg-none" id="sidebarOverlay"></div>

        <!-- Main Viewport Area -->
        <div class="app-main-viewport">
            <!-- Top Operational Bar -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle Sidebar">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
                        </svg>
                    </button>
                    <div class="topbar-breadcrumb">
                        <span class="breadcrumb-dept">Municipal Operations</span>
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-current">@ViewData["Title"]</span>
                    </div>
                </div>

                <div class="topbar-right">
                    <div class="topbar-clock d-none d-md-flex align-items-center me-3 text-secondary small">
                        <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span id="liveClockDisplay">@DateTime.Now.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="dropdown me-2">
                        <button class="btn-civic-quickaction dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            + Quick Action
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item py-2" asp-controller="Disposal" asp-action="Create">+ Log Disposal Request</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Complaint" asp-action="Create">+ File Citizen Grievance</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Sanitization" asp-action="Create">+ Record Sanitization Audit</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2" asp-controller="Worker" asp-action="Create">+ Register Field Worker</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Schedule" asp-action="Create">+ Add Route Timetable</a></li>
                        </ul>
                    </div>

                    <div class="user-profile-menu">
                        @{
                            var username = Context.Session.GetString("Username");
                            var fullName = Context.Session.GetString("FullName") ?? username;
                            var role = Context.Session.GetString("UserRole") ?? "Citizen / User";
                        }
                        @if (!string.IsNullOrEmpty(username))
                        {
                            <div class="user-pill d-flex align-items-center">
                                <div class="user-avatar">
                                    @(!string.IsNullOrEmpty(fullName) ? fullName[0].ToString().ToUpper() : "U")
                                </div>
                                <div class="user-meta d-none d-sm-block">
                                    <div class="user-name">@fullName</div>
                                    <div class="user-role">@role</div>
                                </div>
                                <a class="btn-logout ms-2" asp-controller="Account" asp-action="Logout" title="Sign Out">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                </a>
                            </div>
                        }
                        else
                        {
                            <a class="btn-civic-primary py-1 px-3" asp-controller="Account" asp-action="Login">
                                Sign In / Register
                            </a>
                        }
                    </div>
                </div>
            </header>

            <!-- Main Content Container -->
            <main class="app-content-area" role="main">
                <!-- Toast Notifications -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="civic-toast civic-toast-success alert alert-dismissible fade show mb-3" role="alert">
                        <div class="d-flex align-items-center">
                            <svg class="me-2 text-success flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            <div>
                                <strong>Success:</strong> @TempData["SuccessMessage"]
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="civic-toast civic-toast-danger alert alert-dismissible fade show mb-3" role="alert">
                        <div class="d-flex align-items-center">
                            <svg class="me-2 text-danger flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            <div>
                                <strong>Notice:</strong> @TempData["ErrorMessage"]
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Sticky Civic Footer -->
            <footer class="app-portal-footer">
                <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center px-4">
                    <div class="footer-meta">
                        &copy; 2026 EcoSanitize Municipal Waste Management and Sanitization Portal. All rights reserved.
                    </div>
                    <div class="footer-links">
                        <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                        <a asp-controller="Home" asp-action="Terms">Terms and Conditions</a>
                        <a asp-controller="Analytics" asp-action="PrintableReport" target="_blank">Printable Audit Report</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Generic Confirmation Modal -->
    <div class="modal fade" id="civicConfirmModal" tabindex="-1" aria-labelledby="civicConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="civicConfirmModalLabel">Confirm Municipal Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="civicConfirmModalBody">
                    Are you sure you want to proceed with this update?
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" id="civicConfirmModalBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Responsive sidebar toggle
        document.getElementById('sidebarToggleBtn')?.addEventListener('click', function () {
            document.getElementById('appSidebar')?.classList.toggle('show');
            document.getElementById('sidebarOverlay')?.classList.toggle('show');
        });

        document.getElementById('sidebarCloseBtn')?.addEventListener('click', function () {
            document.getElementById('appSidebar')?.classList.remove('show');
            document.getElementById('sidebarOverlay')?.classList.remove('show');
        });

        document.getElementById('sidebarOverlay')?.addEventListener('click', function () {
            document.getElementById('appSidebar')?.classList.remove('show');
            document.getElementById('sidebarOverlay')?.classList.remove('show');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
