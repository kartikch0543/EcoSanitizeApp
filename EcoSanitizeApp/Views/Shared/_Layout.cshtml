@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoSanitize Portal</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar-civic">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <a class="brand-civic d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <svg class="me-2" style="color: var(--brand-forest);" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                    <span>EcoSanitize</span>
                    <span class="brand-badge d-none d-sm-inline">Municipal Operations</span>
                </a>

                <nav class="d-flex align-items-center gap-1 my-2 my-lg-0">
                    <a class="nav-link-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Dashboard</a>
                    <a class="nav-link-civic @(ViewContext.RouteData.Values["Action"]?.ToString() == "SegregationGuide" ? "active" : "")" asp-controller="Home" asp-action="SegregationGuide">Segregation Rules</a>
                    <a class="nav-link-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Disposal" ? "active" : "")" asp-controller="Disposal" asp-action="Index">Disposal Tracking</a>
                    <a class="nav-link-civic @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Sanitization" ? "active" : "")" asp-controller="Sanitization" asp-action="Index">Sanitization Audits</a>
                </nav>

                <div class="d-flex align-items-center gap-2">
                    @{
                        var username = Context.Session.GetString("Username");
                        var fullName = Context.Session.GetString("FullName") ?? username;
                        var role = Context.Session.GetString("UserRole") ?? "User";
                    }
                    @if (!string.IsNullOrEmpty(username))
                    {
                        <span class="small text-secondary fw-semibold">
                            @fullName <span class="text-muted">(@role)</span>
                        </span>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Account" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn-civic-primary py-1 px-3" asp-controller="Account" asp-action="Login">
                            Sign In / Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <div class="main-content">
        <div class="container my-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-1 mb-3" role="alert">
                    <strong>Success:</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-1 mb-3" role="alert">
                    <strong>Notice:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="portal-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div>
                &copy; 2026 EcoSanitize Municipal Operations Portal. All rights reserved.
            </div>
            <div>
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <a asp-controller="Home" asp-action="Terms">Terms and Conditions</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
