@model EcoSanitizeApp.Models.SanitationComplaint
@{
    ViewData["Title"] = "File Sanitation Grievance";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-3">
            <h1 class="h4 fw-bold mb-1">File Citizen Sanitation Grievance</h1>
            <p class="text-secondary small">Report overflowing municipal bins, clogged street drainage, illegal refuse dumping, or unsanitary public conveniences.</p>
        </div>

        <div class="panel-civic">
            <div class="panel-civic-header">Grievance Information & Evidence</div>
            <div class="panel-civic-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="Brief summary of the issue (e.g. Overflowing bin near West Gate)" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="Overflowing Bin">Overflowing Public Bin</option>
                                <option value="Blocked Drainage">Blocked Street Drainage / Sewer</option>
                                <option value="Illegal Dumping">Illegal Refuse / Debris Dumping</option>
                                <option value="Public Restroom">Unsanitary Public Convenience / Toilet</option>
                                <option value="Sanitation / Odor">Stagnant Water / Foul Odor Hazard</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Severity" class="form-label"></label>
                            <select asp-for="Severity" class="form-select">
                                <option value="Low">Low (Non-urgent routine cleanup)</option>
                                <option value="Medium" selected>Medium (Standard 24-hr resolution)</option>
                                <option value="High">High (Health risk within 6 hrs)</option>
                                <option value="Critical">Critical (Immediate public hazard)</option>
                            </select>
                            <span asp-validation-for="Severity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="Street name, landmark, or building number" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="WardZone" class="form-label"></label>
                            <select asp-for="WardZone" class="form-select">
                                <option value="Zone 1 - North Market">Zone 1 - North Market</option>
                                <option value="Zone 2 - Central Commercial">Zone 2 - Central Commercial</option>
                                <option value="Zone 3 - West Industrial">Zone 3 - West Industrial</option>
                                <option value="Zone 4 - South Residential">Zone 4 - South Residential</option>
                            </select>
                            <span asp-validation-for="WardZone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Provide specific details about the issue, dimensions of debris, duration, or impact on traffic/pedestrians."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Image Upload -->
                    <div class="mb-3">
                        <label class="form-label">Evidence Photo (Optional)</label>
                        <input type="file" name="photoFile" class="form-control" accept="image/png, image/jpeg, image/webp" />
                        <div class="form-text small">Accepted formats: JPG, PNG, WEBP. Maximum file size: 5MB.</div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ReportedBy" class="form-label"></label>
                            <input asp-for="ReportedBy" class="form-control" placeholder="Citizen or inspector name" />
                            <span asp-validation-for="ReportedBy" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label"></label>
                            <input asp-for="ContactNumber" class="form-control" placeholder="Contact mobile number for follow-up" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn-civic-secondary">Cancel and Return</a>
                        <button type="submit" class="btn-civic-primary">Submit Grievance</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
